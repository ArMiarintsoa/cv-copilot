# --- LLM ---
# "anthropic" (API Claude), "openai_compatible" (API gratuite hébergée : Groq, OpenRouter…)
# ou "ollama" (modèle open source local)
LLM_PROVIDER=anthropic

# --- Option gratuite en ligne (Groq : clé sur console.groq.com, sans carte bancaire) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile
# Plus léger / plus rapide : llama-3.1-8b-instant
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Embeddings / Rerank ---
# BAAI/bge-m3 (qualité max, ~2 Go) ou intfloat/multilingual-e5-small (léger, pour tester)
EMBEDDING_MODEL=BAAI/bge-m3
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Stockage ---
DATA_DIR=./data/sessions

# --- Frontend ---
API_URL=http://localhost:8000
